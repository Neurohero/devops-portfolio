# Скопировать в .env и поменять пароли. .env в git не коммитится.
POSTGRES_PASSWORD=change-me
PROFILER_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
# Снимок pg_profile раз в 15 минут, срез ожиданий блокировок раз в 15 секунд
SAMPLE_INTERVAL_SEC=900
LOCKS_INTERVAL_SEC=15
